---
// Estilos globais (a ordem importa: App.css define as variáveis de tema)
import '../App.css'
import '../index.css'
import '../components/ScrollAnimation.css'

const {
  title = 'Vysionis — Desenvolvimento de Sistemas, Apps e Software sob Medida',
  description = 'A Vysionis desenvolve sistemas web, aplicativos e software sob medida para empresas: plataformas de gestão, automação e soluções escaláveis com tecnologia de ponta. Solicite um orçamento.',
  image = '/og-image.png',
} = Astro.props

const siteName = 'Vysionis'
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const socialImage = new URL(image, Astro.site)

// Dados estruturados (Schema.org) — ajuda o Google a entender a empresa.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Vysionis',
  url: Astro.site?.toString(),
  logo: new URL('/logo.svg', Astro.site).toString(),
  description,
  email: 'contato@vysionis.com.br',
  telephone: '+55-11-96580-4957',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'São Paulo',
    addressRegion: 'SP',
    addressCountry: 'BR',
  },
  areaServed: 'BR',
  knowsAbout: [
    'Desenvolvimento de software sob medida',
    'Desenvolvimento web',
    'Aplicativos mobile',
    'Sistemas de gestão',
    'Automação industrial',
  ],
}
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Aplica o tema ANTES da pintura para evitar "flash" (padrão: claro). -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('vysionis-theme')
          document.documentElement.dataset.theme = stored === 'dark' ? 'dark' : 'light'
        } catch (e) {
          document.documentElement.dataset.theme = 'light'
        }
      })()
    </script>

    <!-- SEO básico -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="desenvolvimento de sistemas, software sob medida, desenvolvimento de aplicativos, sistemas de gestão, automação industrial, desenvolvimento web, criação de site, São Paulo"
    />
    <meta name="author" content="Vysionis" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Cor da barra do navegador conforme o tema -->
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0f" media="(prefers-color-scheme: dark)" />

    <!-- Open Graph (WhatsApp, LinkedIn, Facebook) -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Vysionis — estúdio de software sob medida" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />

    <!-- Fonte da marca (Inter) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- Dados estruturados -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    <!-- Sem JS: garante que o conteúdo apareça (não fica preso na animação de entrada) -->
    <noscript>
      <style>
        .scroll-animation .tile {
          opacity: 1 !important;
          animation: none !important;
        }
      </style>
    </noscript>
  </head>
  <body>
    <slot />

    <script>
      import Lenis from 'lenis'
      import 'lenis/dist/lenis.css'

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches

      // Rolagem com inércia (mesma sensação do site de referência). Os links "#..."
      // param logo abaixo do header flutuante.
      if (!reduce) {
        const header = document.querySelector('.header')
        const offset = header ? -(header.getBoundingClientRect().bottom + 8) : 0
        new Lenis({ autoRaf: true, anchors: { offset }, lerp: 0.15, wheelMultiplier: 1.15 })
      }

      // Entrada dos blocos para navegadores sem animação guiada por rolagem
      // (onde há suporte, o CSS cuida disso e esta classe não muda nada).
      const els = Array.from(document.querySelectorAll('[data-reveal]'))

      if (reduce || !('IntersectionObserver' in window)) {
        els.forEach((el) => el.classList.add('visible'))
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible')
                io.unobserve(entry.target)
              }
            }
          },
          { threshold: 0.05, rootMargin: '0px 0px -8% 0px' }
        )
        els.forEach((el) => io.observe(el))
      }
    </script>
  </body>
</html>
