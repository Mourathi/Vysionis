---
// Estilos globais (a ordem importa: App.css define as variáveis de tema)
import '../App.css'
import '../index.css'
import '../components/ScrollAnimation.css'

const {
  title = 'Vysionis — Desenvolvimento de Sistemas, Apps e Software sob Medida',
  description = 'A Vysionis desenvolve sistemas web, aplicativos e software sob medida para empresas: plataformas de gestão, automação e soluções escaláveis com tecnologia de ponta. Solicite um orçamento.',
  image = '/og-image.png',
  // Páginas de produto (ex.: /trinco) usam o ícone do próprio produto
  favicon = '/logo.svg',
} = Astro.props

const siteName = 'Vysionis'
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const socialImage = new URL(image, Astro.site)

// Dados estruturados (Schema.org) — ajuda o Google a entender a empresa.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Vysionis',
  url: Astro.site?.toString(),
  logo: new URL('/logo.svg', Astro.site).toString(),
  description,
  email: 'contato@vysionis.com.br',
  telephone: '+55-11-96580-4957',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'São Paulo',
    addressRegion: 'SP',
    addressCountry: 'BR',
  },
  areaServed: 'BR',
  knowsAbout: [
    'Desenvolvimento de software sob medida',
    'Desenvolvimento web',
    'Aplicativos mobile',
    'Sistemas de gestão',
    'Automação industrial',
  ],
}
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Aplica o tema ANTES da pintura para evitar "flash" (padrão: claro). -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('vysionis-theme')
          document.documentElement.dataset.theme = stored === 'dark' ? 'dark' : 'light'
        } catch (e) {
          document.documentElement.dataset.theme = 'light'
        }
      })()
    </script>

    <!-- SEO básico -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="desenvolvimento de sistemas, software sob medida, desenvolvimento de aplicativos, sistemas de gestão, automação industrial, desenvolvimento web, criação de site, São Paulo"
    />
    <meta name="author" content="Vysionis" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Cor da barra do navegador conforme o tema -->
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0f" media="(prefers-color-scheme: dark)" />

    <!-- Open Graph (WhatsApp, LinkedIn, Facebook) -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Vysionis — estúdio de software sob medida" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={favicon} />

    <!-- Fonte da marca (Inter) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- Dados estruturados -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    <!-- Sem JS: garante que o conteúdo apareça (não fica preso na animação de entrada) -->
    <noscript>
      <style>
        .scroll-animation .tile {
          opacity: 1 !important;
          animation: none !important;
        }
      </style>
    </noscript>
  </head>
  <body>
    <slot />

    <script>
      import Lenis from 'lenis'
      import 'lenis/dist/lenis.css'

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches

      // Rolagem com inércia (mesma sensação do site de referência). Os links "#..."
      // param logo abaixo do header flutuante.
      if (!reduce) {
        const header = document.querySelector('.header')
        const offset = header ? -(header.getBoundingClientRect().bottom + 8) : 0
        new Lenis({ autoRaf: true, anchors: { offset }, lerp: 0.15, wheelMultiplier: 1.15 })
      }

      // Entrada dos blocos para navegadores sem animação guiada por rolagem
      // (onde há suporte, o CSS cuida disso e esta classe não muda nada).
      const els = Array.from(document.querySelectorAll('[data-reveal]'))

      if (reduce || !('IntersectionObserver' in window)) {
        els.forEach((el) => el.classList.add('visible'))
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible')
                io.unobserve(entry.target)
              }
            }
          },
          { threshold: 0.05, rootMargin: '0px 0px -8% 0px' }
        )
        els.forEach((el) => io.observe(el))
      }

      // Animação guiada por rolagem no CSS: Chrome, Edge e Safari 26+. Firefox e iPhone
      // com iOS antigo não têm; neles este script faz o mesmo movimento.
      const cssRolagem = CSS.supports('animation-timeline: view()')
      const limitar = (x) => Math.min(1, Math.max(0, x))
      const aCadaRolagem = (fn) => {
        let pedido = 0
        const rodar = () => {
          pedido = 0
          fn()
        }
        addEventListener('scroll', () => pedido || (pedido = requestAnimationFrame(rodar)), { passive: true })
        addEventListener('resize', rodar)
        rodar()
      }

      // Galeria de Projetos presa na tela: a rolagem vertical passa todos os cards de lado.
      // Liga em qualquer navegador quando o movimento é permitido e a tela tem altura
      // (celular deitado fica com a grade). Mede quanto o trilho anda (--projects-dist).
      const galeria = document.querySelector('.projects')
      if (galeria) {
        const trilho = galeria.querySelector('.projects-track')
        const palco = galeria.querySelector('.projects-sticky')
        const podePrender = matchMedia('(prefers-reduced-motion: no-preference) and (min-height: 520px)')
        let dist = 0
        const mover = () => {
          if (cssRolagem || !galeria.classList.contains('projects--presa')) return
          const curso = galeria.offsetHeight - palco.offsetHeight
          const t = curso > 0 ? limitar(-galeria.getBoundingClientRect().top / curso) : 0
          trilho.style.transform = `translate3d(${(-t * dist).toFixed(1)}px, 0, 0)`
        }
        const medir = () => {
          const presa = galeria.classList.contains('projects--presa')
          dist = presa ? Math.max(0, Math.round(trilho.offsetWidth - palco.clientWidth)) : 0
          galeria.style.setProperty('--projects-dist', String(dist))
          mover()
        }
        const ligar = () => {
          galeria.classList.toggle('projects--presa', podePrender.matches)
          if (!podePrender.matches) trilho.style.transform = ''
          medir()
        }
        podePrender.addEventListener('change', ligar)
        const ro = new ResizeObserver(medir)
        ro.observe(trilho)
        ro.observe(palco)
        ligar()
        aCadaRolagem(mover)
      }

      // Hero que encolhe e escurece ao sair da tela (onde o CSS não faz)
      const heroBento = document.querySelector('.hero-bento')
      if (heroBento && !cssRolagem && !reduce) {
        aCadaRolagem(() => {
          // Posição sem o transform aplicado (offsetTop ignora transform)
          let topo = 0
          for (let el = heroBento; el; el = el.offsetParent) topo += el.offsetTop
          const t = limitar((scrollY - topo) / heroBento.offsetHeight)
          heroBento.style.transform = t ? `scale(${1 - 0.1 * t}) translateY(${6 * t}%)` : ''
          heroBento.style.opacity = t ? String(1 - 0.75 * t) : ''
        })
      }
    </script>
  </body>
</html>
