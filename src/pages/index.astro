---
import Layout from '../layouts/Layout.astro'
import Header from '../components/Header.jsx'
import Hero from '../components/Hero.jsx'
import ParaQuem from '../components/ParaQuem.jsx'
import Projects from '../components/Projects.jsx'
import Services from '../components/Services.jsx'
import Processo from '../components/Processo.jsx'
import Technologies from '../components/Technologies.jsx'
import Duvidas from '../components/Duvidas.jsx'
import Contact from '../components/Contact.jsx'
import Footer from '../components/Footer.jsx'
import ScreenNav from '../components/ScreenNav.jsx'
import Band from '../components/Band.jsx'
---

<Layout>
  <div class="app">
    {/* Islands interativas: precisam de JS no cliente */}
    <ScreenNav client:idle />
    <Header client:load />

    {/* Roteiro de venda: a dor → o que fazemos → prova real → como funciona → por que
        confiar → dúvidas → contato. Cada bloco termina perto de um "diagnóstico grátis". */}
    <main>
      <Hero />

      {/* Faixas de texto gigante que correm de lado conforme a rolagem */}
      <Band items={['Sem planilha', 'Sem retrabalho', 'Sem papel', 'Tudo num lugar']} />

      {/* Blocos "jogados" na tela pela rolagem (ScrollAnimation.css) */}
      <div class="scroll-animation" data-reveal><ParaQuem /></div>
      <div class="scroll-animation" data-reveal><Services /></div>

      {/* Caso real em galeria horizontal presa na tela — tem a própria animação */}
      <Projects />

      <div class="scroll-animation" data-reveal><Processo /></div>
      <div class="scroll-animation" data-reveal><Technologies /></div>

      <Band items={['Diagnóstico grátis', 'Preço fechado', 'Vamos conversar']} reverse />

      <div class="scroll-animation" data-reveal><Duvidas /></div>
      <div class="scroll-animation" data-reveal><Contact client:visible /></div>
    </main>

    <Footer />
  </div>
</Layout>
